{
  "name": "vdacc",
  "version": "3.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "serve": "bun ts/src/server.ts",
    "probe": "bun ts/src/cli.ts probe",
    "get": "bun ts/src/cli.ts get",
    "test": "bun test ts/tests",
    "parity": "python ts/scripts/parity.py",
    "baseline": "node tools/release_baseline.cjs",
    "motion": "node tools/reduced_motion_check.cjs"
  }
}
