<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      只有 Android 9 及以下才需要靠它直接写 /storage/emulated/0/Download/VDACC；
      Android 10+ 走 MediaStore（IS_PENDING + RELATIVE_PATH），不需要任何存储权限。
      maxSdkVersion=28 让新系统上根本不会申请这条权限，避免「装了个下载器却要存储权限」的疑问。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 下载期间的前台服务：锁屏后系统会冻结后台进程，没有它进度会停 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ 要求声明具体类型；dataSync 就是「在传数据」这一类 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 锁屏时保持 CPU 不睡（前台服务保证网络，唤醒锁保证不降频） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- API 33+ 通知要用户授权；没授权服务仍能跑，只是看不见进度 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- usesCleartextTraffic：服务端是 http://<局域网IP>:端口，没有 TLS；壳子只连自己的电脑 -->
    <application
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
          singleTop：从别的 App「分享」到 VDACC 时，若已经在前台就复用当前实例
          （onNewIntent 里换 url 重新加载），而不是叠一层新页面。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              分享入口：只接 text/plain。B站/抖音/音乐 App 的「分享」几乎都是
              「标题 + 链接」的一段文字，引擎会自己抽链接；不接管 http/https 的 VIEW，
              那会让本应用出现在「用什么打开网页」的候选里，声明过重。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 登录页：独立 Activity + 独立 WebView，**不注入桥**（远端页面不该拿到 fs/网络能力） -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
