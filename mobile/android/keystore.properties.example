# 复制成 keystore.properties 再填（该文件已在 .gitignore 里，不会入库）
#
# 生成密钥（JDK 17）：
#   keytool -genkeypair -v -keystore keystore/vdacc-release.jks -alias vdacc \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=VDACC, OU=Personal, O=VDACC, L=Local, ST=Local, C=CN"
#
# 注意：**这个 jks 与密码丢了就再也签不出同一个应用**（升级会要求卸载重装），
# 请自己备份到仓库之外。CI 上不要提交它，用环境变量或 secrets 还原。
storeFile=keystore/vdacc-release.jks
storePassword=换成你的密码
keyAlias=vdacc
keyPassword=换成你的密码
